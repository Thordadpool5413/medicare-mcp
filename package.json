{
  "name": "@thordadpool5413/medicare-intelligence-console",
  "version": "1.0.0",
  "description": "A full Medicare Intelligence Console web app built on top of the Medicare MCP server and CMS Medicare data.",
  "license": "MIT",
  "type": "module",
  "author": "Joan Saez-Pons (https://github.com/openpharma-org), app wrapper by Thordadpool5413",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thordadpool5413/medicare-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Thordadpool5413/medicare-mcp/issues"
  },
  "homepage": "https://github.com/Thordadpool5413/medicare-mcp#readme",
  "keywords": [
    "medicare",
    "cms",
    "healthcare",
    "providers",
    "mcp",
    "api",
    "server",
    "physician",
    "beneficiaries",
    "dashboard",
    "analytics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "medicare-mcp-server": "build/index.js",
    "medicare-intelligence-console": "build/web.js"
  },
  "files": [
    "build",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rm -rf build",
    "build": "tsc && node -e \"const fs=require('fs'); for (const file of ['build/index.js','build/web.js']) { if (!fs.existsSync(file)) throw new Error(file + ' was not emitted by TypeScript'); fs.chmodSync(file, 0o755); }\"",
    "watch": "tsc --watch",
    "start": "node -r dotenv/config build/index.js",
    "start:http": "USE_HTTP=true node -r dotenv/config build/index.js",
    "app": "node -r dotenv/config build/web.js",
    "dev:app": "npm run build && npm run app",
    "clean": "rm -rf build coverage *.tgz"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.4",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
