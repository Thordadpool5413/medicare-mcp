# Medicare Intelligence Console
# Copy this file to .env for local development.

# Browser app port
APP_PORT=8080

# Embedded Medicare API port
API_PORT=3000

# Set this to false only if you want to run the Medicare API separately.
START_EMBEDDED_API=true

# Optional external Medicare API URL.
# When this is set, the app will not start the embedded API.
# MEDICARE_API_URL=http://127.0.0.1:3000

# Optional logging controls inherited by the upstream MCP server.
LOG_LEVEL=info

# Keep private keys out of the repo.
# Add OPENAI_API_KEY only through your local .env file or GitHub Secrets.
# OPENAI_API_KEY=
