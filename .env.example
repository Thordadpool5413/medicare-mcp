APP_PORT=8080
API_PORT=3000
START_EMBEDDED_API=true
LOG_LEVEL=info
# MEDICARE_API_URL=http://127.0.0.1:3000
# OPENAI_API_KEY=

# Supabase backend persistence
# Use the Project URL from Supabase settings.
# Example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Recommended for the server backend only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback if you only want read/write through anon policies.
# SUPABASE_ANON_KEY=

# Optional owner namespace for saved views and query history.
SUPABASE_OWNER_ID=default

# Optional custom table names. Defaults match supabase/schema.sql.
SUPABASE_SAVED_VIEWS_TABLE=medicare_saved_views
SUPABASE_QUERY_RUNS_TABLE=medicare_query_runs
